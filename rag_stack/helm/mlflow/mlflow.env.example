# MLflow Backend Configuration
# Copy this file to mlflow.env and fill in your values
# Then run: source mlflow.env

# S3 Artifact Storage
export MLFLOW_S3_BUCKET="your-s3-bucket-name"
export MLFLOW_S3_ROLE_ARN="arn:aws:iam::YOUR_ACCOUNT:role/mlflow-s3-role"

# PostgreSQL Backend Store
export MLFLOW_DB_ENDPOINT="your-rds-endpoint.region.rds.amazonaws.com"
export MLFLOW_DB_NAME="mlflow"
export MLFLOW_DB_USERNAME="mlflow"
export MLFLOW_DB_PASSWORD="your-secure-password"
