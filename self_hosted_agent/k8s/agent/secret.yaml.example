apiVersion: v1
kind: Secret
metadata:
  name: pr-review-agent-secrets
  namespace: agent
type: Opaque
stringData:
  # GitHub token for API access
  GITHUB_TOKEN: "your-github-token-here"

---
# To create the actual secret, copy this file to secret.yaml and fill in the values:
# cp secret.yaml.example secret.yaml
# Then edit secret.yaml with your actual tokens
# Apply with: kubectl apply -f secret.yaml
# 
# IMPORTANT: Never commit secret.yaml to git!
